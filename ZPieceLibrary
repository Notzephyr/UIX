				DLItemList.Padding = UDim.new(0, 3)
				Library:UpdateScrolling(DLScroll, DLItemList)

				local DropFunc = {
					Value = typeof(cfg.Default) == "string" and {cfg.Default} or cfg.Default,
					CurrentOption = typeof(cfg.Default) == "string" and {cfg.Default} or cfg.Default,
				}

				local function UpdateSelectText()
					SelectText.Text = table.concat(DropFunc.Value, ", ")
				end

				local function PopulateItems()
					for _, child in next, DLScroll:GetChildren() do
						if child:IsA("Frame") then child:Destroy() end
					end
					for _, optionName in next, cfg.Values do
						local Item = Instance.new("Frame", DLScroll)
						Item.Name = "Item"
						Item.BackgroundColor3 = T.SurfaceLight
						Item.BackgroundTransparency = 0.6
						Item.BorderSizePixel = 0
						Item.Size = UDim2.new(1, 0, 0, 30)
						Instance.new("UICorner", Item).CornerRadius = UDim.new(0, 5)
						local ItemTitle = Instance.new("TextLabel", Item)
						ItemTitle.Name = "Title"
						ItemTitle.BackgroundTransparency = 1
						ItemTitle.Position = UDim2.new(0, 10, 0, 0)
						ItemTitle.Size = UDim2.new(1, -36, 1, 0)
						ItemTitle.Font = Enum.Font.Gotham
						ItemTitle.Text = optionName
						ItemTitle.TextColor3 = T.TextDim
						ItemTitle.TextSize = 12
						ItemTitle.TextXAlignment = Enum.TextXAlignment.Left
						local ItemClick = Instance.new("TextButton", Item)
						ItemClick.BackgroundTransparency = 1
						ItemClick.Size = UDim2.new(1, 0, 1, 0)
						ItemClick.Text = ""
						-- Checkmark
						local Tick = Instance.new("ImageLabel", Item)
						Tick.AnchorPoint = Vector2.new(1, 0.5)
						Tick.Position = UDim2.new(1, -8, 0.5, 0)
						Tick.Size = UDim2.new(0, 14, 0, 14)
						Tick.BackgroundTransparency = 1
						Tick.Image = "rbxassetid://3926305904"
						Tick.ImageRectOffset = Vector2.new(312, 4)
						Tick.ImageRectSize = Vector2.new(24, 24)
						Tick.ImageColor3 = T.Accent
						Tick.Visible = table.find(DropFunc.Value, optionName) ~= nil

						Item.MouseEnter:Connect(function()
							Library:Tween(Item, 0.15, {BackgroundTransparency = 0.4})
						end)
						Item.MouseLeave:Connect(function()
							Library:Tween(Item, 0.15, {BackgroundTransparency = 0.6})
						end)
						ItemClick.Activated:Connect(function()
							if not cfg.MultiSelect then
								DropFunc.Value = {optionName}
								DropFunc.CurrentOption = {optionName}
								-- Hide all ticks then show this one
								for _, c in next, DLScroll:GetChildren() do
									if c:IsA("Frame") and c:FindFirstChild("Title") then
										local t = c:FindFirstChild("Icon") -- tick frame
										if t then t.Visible = false end
									end
								end
							else
								local idx = table.find(DropFunc.Value, optionName)
								if idx then
									table.remove(DropFunc.Value, idx)
								else
									table.insert(DropFunc.Value, optionName)
								end
								DropFunc.CurrentOption = DropFunc.Value
							end
							Tick.Visible = table.find(DropFunc.Value, optionName) ~= nil
							UpdateSelectText()
							cfg.Callback(cfg.MultiSelect and DropFunc.Value or DropFunc.Value[1])
						end)
					end
				end
				PopulateItems()

				-- Search filter inside dropdown
				DLSearchBox:GetPropertyChangedSignal("Text"):Connect(function()
					local q = string.lower(DLSearchBox.Text or "")
					for _, item in next, DLScroll:GetChildren() do
						if item:IsA("Frame") and item:FindFirstChild("Title") then
							item.Visible = q == "" or string.find(string.lower(item.Title.Text or ""), q, 1, true) ~= nil
						end
					end
				end)

				local function OpenDrop()
					DropdownZone.Visible = true
					DropList.Visible = true
					Library:Tween(DropdownZone, 0.2, {BackgroundTransparency = 0.25})
				end
				local function CloseDrop()
					Library:Tween(DropdownZone, 0.2, {BackgroundTransparency = 1})
					task.wait(0.2)
					DropList.Visible = false
					DropdownZone.Visible = false
				end

				local DropClick = Instance.new("TextButton", SelectBox)
				DropClick.BackgroundTransparency = 1
				DropClick.Size = UDim2.new(1, 0, 1, 0)
				DropClick.Text = ""
				DropClick.Activated:Connect(OpenDrop)
				DLClose.Activated:Connect(CloseDrop)

				function DropFunc:Set(v)
					self.Value = typeof(v) == "string" and {v} or v
					self.CurrentOption = self.Value
					UpdateSelectText()
					PopulateItems()
				end

				UpdateSelectText()
				if cfg.Flag then Library.Flags[cfg.Flag] = DropFunc end
				return DropFunc
			end

