		local function ActivateTab()
			LayoutLabel.Text = TabName
			LayoutIcon.Image = TabIcon or ""
			-- Deselect all tabs
			for _, v in next, ScrollingTab:GetChildren() do
				if v:IsA("Frame") and v:FindFirstChild("NameTab") then
					Library:Tween(v.NameTab, 0.2, {TextTransparency = 0.35})
					v.NameTab.Font = Enum.Font.Gotham
					v.NameTab.TextColor3 = T.TextDim
					if v:FindFirstChild("ActiveBar") then v.ActiveBar.Visible = false end
					if v:FindFirstChild("TabBg") then Library:Tween(v.TabBg, 0.2, {BackgroundTransparency = 1}) end
					if v:FindFirstChild("TabIcon") then Library:Tween(v.TabIcon, 0.2, {ImageColor3 = T.Muted}) end
				end
			end
			-- Activate this tab
			Library:Tween(NameTab, 0.2, {TextTransparency = 0})
			NameTab.Font = Enum.Font.GothamBold
			NameTab.TextColor3 = T.White
			ActiveBar.Visible = true
			Library:Tween(TabBg, 0.2, {BackgroundTransparency = 0.88})
			if IconLabel then Library:Tween(IconLabel, 0.2, {ImageColor3 = T.Accent}) end
			UIPageLayout:JumpToIndex(Layout.LayoutOrder)
		end

