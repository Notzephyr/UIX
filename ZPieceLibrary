local Library = {
	Flags = {},
	ConfigurationSaving = {
		Enabled = false,
		FolderName = "ZHUB",
		FileName = "Config"
	}
}

function Library:SaveConfiguration()
	if not self.ConfigurationSaving.Enabled then return end
	local Data = {}
	for i, v in pairs(self.Flags) do
		Data[i] = v.Value or v.CurrentValue or v.CurrentOption or v.Text
	end
	local folderPath = self.ConfigurationSaving.FolderName
	local filePath = folderPath .. "/" .. self.ConfigurationSaving.FileName .. ".json"
	if not isfolder(folderPath) then makefolder(folderPath) end
	writefile(filePath, game:GetService("HttpService"):JSONEncode(Data))
end

function Library:LoadConfiguration()
	local folderPath = self.ConfigurationSaving.FolderName
	local filePath = folderPath .. "/" .. self.ConfigurationSaving.FileName .. ".json"
	pcall(function()
		if isfile(filePath) then
			local success, data = pcall(function()
				return game:GetService("HttpService"):JSONDecode(readfile(filePath))
			end)
			if success and type(data) == "table" then
				for flagName, value in pairs(data) do
					if self.Flags[flagName] and self.Flags[flagName].Set then
						pcall(function() self.Flags[flagName]:Set(value) end)
					end
				end
			end
		end
	end)
end

