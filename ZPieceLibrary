-- ─── HELPERS ────────────────────────────────────────────────────────────────
function Library:Tween(obj, t, props)
	local tw = game:GetService("TweenService"):Create(obj, TweenInfo.new(t, Enum.EasingStyle.Quad), props)
	tw:Play()
	return tw
end

function Library:UpdateScrolling(Scroll, List)
	List:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		Scroll.CanvasSize = UDim2.new(0, 0, 0, List.AbsoluteContentSize.Y + 15)
	end)
end

function Library:MakeConfig(Config, NewConfig)
	for i, v in next, Config do
		if not NewConfig[i] then NewConfig[i] = v end
	end
	return NewConfig
end

-- Backwards compat aliases
function Library:TweenInstance(Instance, Time, OldValue, NewValue)
	return self:Tween(Instance, Time, {[OldValue] = NewValue})
end

function Library:UpdateContent(Content, Title, Object)
	if Content.Text ~= "" then
		Title.Position = UDim2.new(0, 10, 0, 7)
		Title.Size = UDim2.new(1, -60, 0, 16)
		local MaxY = math.max(Content.TextBounds.Y + 15, 45)
		Object.Size = UDim2.new(1, 0, 0, MaxY)
	end
end

function Library:MouseEvent(obj, enter, leave)
	obj.MouseEnter:Connect(enter)
	obj.MouseLeave:Connect(leave)
end

-- ─── DRAGGABLE ──────────────────────────────────────────────────────────────
function Library:MakeDraggable(topbar, object)
	local Dragging, DragInput, DragStart, StartPos
	topbar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			Dragging = true
			DragStart = input.Position
			StartPos = object.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then Dragging = false end
			end)
		end
	end)
	topbar.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			DragInput = input
		end
	end)
	game:GetService("UserInputService").InputChanged:Connect(function(input)
		if input == DragInput and Dragging then
			local Delta = input.Position - DragStart
			local pos = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + Delta.X, StartPos.Y.Scale, StartPos.Y.Offset + Delta.Y)
			game:GetService("TweenService"):Create(object, TweenInfo.new(0.15), {Position = pos}):Play()
		end
	end)
end

-- ─── RESIZABLE ──────────────────────────────────────────────────────────────
function Library:MakeResizable(object, holder)
	local Handle = Instance.new("TextButton")
	Handle.Name = "ResizeHandle"
	Handle.Parent = object
	Handle.Size = UDim2.new(0, 28, 0, 28)
	Handle.Position = UDim2.new(1, 0, 1, 0)
	Handle.AnchorPoint = Vector2.new(1, 1)
	Handle.BackgroundTransparency = 1
	Handle.Text = ""
	Handle.ZIndex = 10

	local Grabber = Instance.new("Frame")
	Grabber.Parent = Handle
	Grabber.Size = UDim2.new(0, 5, 0, 5)
	Grabber.Position = UDim2.new(1, -3, 1, -3)
	Grabber.AnchorPoint = Vector2.new(1, 1)
	Grabber.BackgroundColor3 = T.Accent
	Grabber.BorderSizePixel = 0
	Grabber.BackgroundTransparency = 0.1
	Instance.new("UICorner", Grabber).CornerRadius = UDim.new(1, 0)

	local Dragging, DragStart, StartSize = false, nil, nil
	Handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			Dragging = true
			DragStart = game:GetService("UserInputService"):GetMouseLocation()
			StartSize = object.AbsoluteSize
		end
	end)
	game:GetService("UserInputService").InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = false end
	end)
	game:GetService("RunService").RenderStepped:Connect(function()
		if Dragging then
			local MousePos = game:GetService("UserInputService"):GetMouseLocation()
			local Delta = MousePos - DragStart
			local Scale = 1
			local ScaleObj = holder:FindFirstChildOfClass("UIScale")
			if ScaleObj then Scale = ScaleObj.Scale end
			object.Size = UDim2.new(0, math.max(480, StartSize.X + Delta.X / Scale), 0, math.max(280, StartSize.Y + Delta.Y / Scale))
			holder.Size = object.Size
		end
	end)
end

-- ─── UTILITY: create a styled button for the title bar ─────────────────────
local function MakeTitleBtn(parent, order, bgColor, iconId, rectOffset, rectSize, size)
	local Btn = Instance.new("TextButton")
	Btn.Size = UDim2.new(0, 26, 0, 26)
	Btn.BackgroundColor3 = bgColor
	Btn.BackgroundTransparency = 0.2
	Btn.BorderSizePixel = 0
	Btn.Text = ""
	Btn.LayoutOrder = order
	Btn.Parent = parent
	Btn.AutoButtonColor = false
	Btn.ClipsDescendants = true
	local c = Instance.new("UICorner", Btn)
	c.CornerRadius = UDim.new(0, 6)
	local s = Instance.new("UIStroke", Btn)
	s.Color = bgColor
	s.Transparency = 0.55
	s.Thickness = 1
	local ico = Instance.new("ImageLabel", Btn)
	ico.AnchorPoint = Vector2.new(0.5, 0.5)
	ico.Position = UDim2.new(0.5, 0, 0.5, 0)
	ico.Size = UDim2.new(0, size or 12, 0, size or 12)
	ico.BackgroundTransparency = 1
	ico.Image = iconId
	if rectOffset then
		ico.ImageRectOffset = rectOffset
		ico.ImageRectSize = rectSize
	end
	ico.ImageColor3 = T.White
	-- Hover
	Btn.MouseEnter:Connect(function()
		game:GetService("TweenService"):Create(Btn, TweenInfo.new(0.15), {BackgroundTransparency = 0}):Play()
	end)
	Btn.MouseLeave:Connect(function()
		game:GetService("TweenService"):Create(Btn, TweenInfo.new(0.15), {BackgroundTransparency = 0.2}):Play()
	end)
	return Btn
end

