local function Tween(obj, t, props)
        TweenService:Create(obj, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

function Library:TweenInstance(Instance, Time, OldValue, NewValue)
        local rz_Tween = TweenService:Create(Instance, TweenInfo.new(Time, Enum.EasingStyle.Quad), { [OldValue] = NewValue })
        rz_Tween:Play()
        return rz_Tween
end

function Library:UpdateContent(Content, Title, Object)
        if Content.Text ~= "" then
                Title.Position = UDim2.new(0, 10, 0, 7)
                Title.Size = UDim2.new(1, -60, 0, 16)
                local MaxY = math.max(Content.TextBounds.Y + 15, 45)
                Object.Size = UDim2.new(1, 0, 0, MaxY)
        end
end

function Library:UpdateScrolling(Scroll, List)
        List:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                Scroll.CanvasSize = UDim2.new(0, 0, 0, List.AbsoluteContentSize.Y + 15)
        end)
end

function Library:MouseEvent(Obj, ...)
        local Args = { ... }
        Obj.MouseEnter:Connect(Args[1])
        Obj.MouseLeave:Connect(Args[2])
end

function Library:MakeConfig(Config, NewConfig)
        for i, v in next, Config do
                if not NewConfig[i] then
                        NewConfig[i] = v
                end
        end
        return NewConfig
end

function Library:RoundToIncrement(Value, Increment)
        local NumberValue = tonumber(Value) or 0
        local Step = tonumber(Increment) or 1
        if Step <= 0 then Step = 1 end
        local Result = math.floor((NumberValue / Step) + 0.5) * Step
        local Decimals = tostring(Step):match("%.(%d+)")
        if Decimals then
                local Precision = 10 ^ math.min(#Decimals, 6)
                Result = math.floor((Result * Precision) + 0.5) / Precision
        end
        return Result
end

function Library:ClampSliderValue(Value, Min, Max, Increment)
        local MinValue = tonumber(Min) or 0
        local MaxValue = tonumber(Max) or MinValue
        local NumberValue = tonumber(Value) or MinValue
        if MaxValue < MinValue then MinValue, MaxValue = MaxValue, MinValue end
        return math.clamp(self:RoundToIncrement(NumberValue, Increment), MinValue, MaxValue)
end

function Library:MakeDraggable(topbarobject, object)
        local Dragging, DragInput, DragStart, StartPosition = nil, nil, nil, nil
        local function UpdatePos(input)
                local Delta = input.Position - DragStart
                local pos = UDim2.new(StartPosition.X.Scale, StartPosition.X.Offset + Delta.X, StartPosition.Y.Scale, StartPosition.Y.Offset + Delta.Y)
                TweenService:Create(object, TweenInfo.new(0.15), { Position = pos }):Play()
        end
        topbarobject.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        Dragging = true
                        DragStart = input.Position
                        StartPosition = object.Position
                        input.Changed:Connect(function()
                                if input.UserInputState == Enum.UserInputState.End then Dragging = false end
                        end)
                end
        end)
        topbarobject.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                        DragInput = input
                end
        end)
        UserInputService.InputChanged:Connect(function(input)
                if input == DragInput and Dragging then UpdatePos(input) end
        end)
end

local function MakeCorner(parent, radius)
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, radius or 6)
        c.Parent = parent
        return c
end

local function MakeStroke(parent, color, thickness, transparency)
        local s = Instance.new("UIStroke")
        s.Color = color or CrimsonVibe.Border
        s.Thickness = thickness or 1
        s.Transparency = transparency or 0
        s.Parent = parent
        return s
end

local function MakeGradient(parent, colorSeq, transSeq, rotation)
        local g = Instance.new("UIGradient")
        g.Color = colorSeq or ColorSequence.new(CrimsonVibe.Surface, CrimsonVibe.Background)
        if transSeq then g.Transparency = transSeq end
        g.Rotation = rotation or 90
        g.Parent = parent
        return g
end

