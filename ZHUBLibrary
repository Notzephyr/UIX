function Library:MakeResizable(object, holder)
	local Handle = Instance.new("TextButton")
	Handle.Name = "ResizeHandle"
	Handle.Parent = object
	Handle.Size = UDim2.new(0, 30, 0, 30)
	Handle.Position = UDim2.new(1, 0, 1, 0)
	Handle.AnchorPoint = Vector2.new(1, 1)
	Handle.BackgroundTransparency = 1
	Handle.Text = ""
	Handle.ZIndex = 10

	local Grabber = Instance.new("Frame", Handle)
	Grabber.Size = UDim2.new(0, 8, 0, 8)
	Grabber.Position = UDim2.new(1, -4, 1, -4)
	Grabber.AnchorPoint = Vector2.new(1, 1)
	Grabber.BackgroundColor3 = T.Accent
	Grabber.BorderSizePixel = 0
	Grabber.BackgroundTransparency = 0
	Instance.new("UICorner", Grabber).CornerRadius = UDim.new(1, 0)
	local GStroke = Instance.new("UIStroke", Grabber)
	GStroke.Color = T.AccentBright
	GStroke.Thickness = 1
	GStroke.Transparency = 0.3

	local Dragging, DragStart, StartSize = false, nil, nil
	Handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			Dragging = true
			DragStart = UserInputService:GetMouseLocation()
			StartSize = object.AbsoluteSize
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			Dragging = false
		end
	end)
	RunService.RenderStepped:Connect(function()
		if Dragging then
			local MousePos = UserInputService:GetMouseLocation()
			local Delta = MousePos - DragStart
			local Scale = 1
			local ScaleObj = holder:FindFirstChildOfClass("UIScale")
			if ScaleObj then Scale = ScaleObj.Scale end
			object.Size  = UDim2.new(0, math.max(480, StartSize.X + Delta.X / Scale), 0, math.max(300, StartSize.Y + Delta.Y / Scale))
			holder.Size  = object.Size
		end
	end)
end

