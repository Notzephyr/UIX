				local DragBtn = Instance.new("TextButton", Row)
				DragBtn.BackgroundTransparency = 1
				DragBtn.Position = UDim2.new(0, 0, 0, 26)
				DragBtn.Size = UDim2.new(1, 0, 0, 30)
				DragBtn.Text = ""
				DragBtn.AutoButtonColor = false
				DragBtn.ZIndex = 5

				local Func = { Value = cfg.Default, CurrentValue = cfg.Default }
				local function UpdateSlider(val)
					val = math.clamp(
						math.round(val / (10^-(cfg.Decimals or 0))) / (10^(cfg.Decimals or 0)),
						cfg.Min, cfg.Max
					)
					Func.Value = val
					Func.CurrentValue = val
					local pct = (val - cfg.Min) / (cfg.Max - cfg.Min)
					ValLabel.Text = tostring(val)
					Library:Tween(TrackFill, 0.06, {Size = UDim2.new(pct, 0, 1, 0)})
					Library:Tween(Knob, 0.06, {Position = UDim2.new(pct, 0, 0.5, 0)})
					cfg.Callback(val)
				end
				UpdateSlider(cfg.Default)

				function Func:Set(val) UpdateSlider(val) end

				local Sliding = false

				local function GetPctFromInput(inputPos)
					local abs = TrackBg.AbsolutePosition
					local w   = TrackBg.AbsoluteSize.X
					return math.clamp((inputPos.X - abs.X) / w, 0, 1)
				end

				-- Mouse support
				DragBtn.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						Sliding = true
						Library:Tween(Knob, 0.1, {Size = UDim2.new(0, 20, 0, 20)})
					end
				end)

				-- Touch support
				DragBtn.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.Touch then
						Sliding = true
						Library:Tween(Knob, 0.1, {Size = UDim2.new(0, 20, 0, 20)})
						local function onChanged()
							if Sliding then
								local pct = GetPctFromInput(input.Position)
								UpdateSlider(cfg.Min + (cfg.Max - cfg.Min) * pct)
							end
						end
						input.Changed:Connect(function()
							if input.UserInputState == Enum.UserInputState.Change then
								onChanged()
							elseif input.UserInputState == Enum.UserInputState.End then
								Sliding = false
								Library:Tween(Knob, 0.1, {Size = UDim2.new(0, 17, 0, 17)})
							end
						end)
					end
				end)

				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 and Sliding then
						Sliding = false
						Library:Tween(Knob, 0.1, {Size = UDim2.new(0, 17, 0, 17)})
					end
				end)

				UserInputService.InputChanged:Connect(function(input)
					if Sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
						local pct = GetPctFromInput(input.Position)
						UpdateSlider(cfg.Min + (cfg.Max - cfg.Min) * pct)
					end
				end)

				if cfg.Flag then Library.Flags[cfg.Flag] = Func end
				return Func
			end

