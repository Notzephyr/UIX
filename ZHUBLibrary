								for _, c in next, DLScroll:GetChildren() do
									if c:IsA("Frame") then
										local t = c:FindFirstChildOfClass("ImageLabel")
										if t then t.Visible = false end
									end
								end
							else
								local idx = table.find(DropFunc.Value, optionName)
								if idx then
									table.remove(DropFunc.Value, idx)
								else
									table.insert(DropFunc.Value, optionName)
								end
								DropFunc.CurrentOption = DropFunc.Value
							end
							Tick.Visible = table.find(DropFunc.Value, optionName) ~= nil
							UpdateSelectText()
							cfg.Callback(cfg.MultiSelect and DropFunc.Value or DropFunc.Value[1])
						end)
					end
				end
				PopulateItems()

				DLSearchBox:GetPropertyChangedSignal("Text"):Connect(function()
					local q = string.lower(DLSearchBox.Text or "")
					for _, item in next, DLScroll:GetChildren() do
						if item:IsA("Frame") and item:FindFirstChild("Title") then
							item.Visible = q == "" or string.find(string.lower(item.Title.Text or ""), q, 1, true) ~= nil
						end
					end
				end)

				local function OpenDrop()
					DropdownZone.Visible = true
					DropList.Visible = true
					Library:Tween(DropdownZone, 0.18, {BackgroundTransparency = 0.22})
				end
				local function CloseDrop()
					Library:Tween(DropdownZone, 0.18, {BackgroundTransparency = 1})
					task.wait(0.2)
					DropList.Visible = false
					DropdownZone.Visible = false
				end

				local DropClick = Instance.new("TextButton", SelectBox)
				DropClick.BackgroundTransparency = 1
				DropClick.Size = UDim2.new(1, 0, 1, 0)
				DropClick.Text = ""
				DropClick.AutoButtonColor = false
				DropClick.Activated:Connect(OpenDrop)
				DLClose.Activated:Connect(CloseDrop)

				function DropFunc:Set(v)
					self.Value = typeof(v) == "string" and {v} or v
					self.CurrentOption = self.Value
					UpdateSelectText()
					PopulateItems()
				end

				UpdateSelectText()
				if cfg.Flag then Library.Flags[cfg.Flag] = DropFunc end
				return DropFunc
			end

			-- ── TEXTBOX ─────────────────────────────────────────────────────
			function SectionFunc:AddTextbox(cfg)
				cfg = Library:MakeConfig({
					Title = "Textbox",
					Description = "",
					Default = "",
					PlaceholderText = "Enter text...",
					Flag = nil,
					Callback = function() end,
				}, cfg or {})

				local Row = MakeControlBg(SectionList, 38)
				Row.Name = "Textbox"

				local TitleLabel = Instance.new("TextLabel", Row)
				TitleLabel.Name = "Title"
				TitleLabel.BackgroundTransparency = 1
				TitleLabel.Position = UDim2.new(0, 12, 0, 0)
				TitleLabel.Size = UDim2.new(0.48, 0, 1, 0)
				TitleLabel.Font = Enum.Font.GothamBold
				TitleLabel.Text = cfg.Title
				TitleLabel.TextColor3 = T.White
				TitleLabel.TextSize = 12
				TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

				local InputFrame = Instance.new("Frame", Row)
				InputFrame.AnchorPoint = Vector2.new(1, 0.5)
				InputFrame.Position = UDim2.new(1, -10, 0.5, 0)
				InputFrame.Size = UDim2.new(0, 118, 0, 26)
				InputFrame.BackgroundColor3 = T.SurfaceMid
				InputFrame.BorderSizePixel = 0
				Instance.new("UICorner", InputFrame).CornerRadius = UDim.new(0, 6)
				local IFStroke = Instance.new("UIStroke", InputFrame)
				IFStroke.Color = T.Border
				IFStroke.Thickness = 1
				IFStroke.Transparency = 0.25

				local TB = Instance.new("TextBox", InputFrame)
				TB.BackgroundTransparency = 1
				TB.BorderSizePixel = 0
				TB.Position = UDim2.new(0, 7, 0, 0)
				TB.Size = UDim2.new(1, -14, 1, 0)
				TB.Font = Enum.Font.Gotham
				TB.PlaceholderText = cfg.PlaceholderText
				TB.PlaceholderColor3 = T.MutedDark
				TB.Text = cfg.Default
				TB.TextColor3 = T.White
				TB.TextSize = 11
				TB.TextXAlignment = Enum.TextXAlignment.Left
				TB.ClearTextOnFocus = false

				TB.FocusLost:Connect(function()
					Library:Tween(IFStroke, 0.15, {Transparency = 0.25, Color = T.Border})
					cfg.Callback(TB.Text)
				end)
				TB.Focused:Connect(function()
					Library:Tween(IFStroke, 0.15, {Transparency = 0, Color = T.Accent})
				end)

				local Func = { Text = cfg.Default, Value = cfg.Default }
				function Func:Set(v) TB.Text = v self.Text = v self.Value = v end
				if cfg.Flag then Library.Flags[cfg.Flag] = Func end
				return Func
			end

			return SectionFunc
		end -- AddSection

		return TabFunc
	end -- Tab:New

	function Tab:T(name)
		return self:New({Name = name})
	end

	return Tab
end -- NewWindow

return Library
