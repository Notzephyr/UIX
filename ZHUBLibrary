	Btn.InputChanged:Connect(function(input)
		if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) and togDragStart then
			local delta = input.Position - togDragStart
			if delta.Magnitude > 5 then
				togDragging = true
				Btn.Position = UDim2.new(
					togStartPos.X.Scale, togStartPos.X.Offset + delta.X,
					togStartPos.Y.Scale, togStartPos.Y.Offset + delta.Y
				)
			end
		end
	end)

	return Btn, togDragging
end

